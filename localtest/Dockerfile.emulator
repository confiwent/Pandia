# Local Pandia emulator for a no-GPU Docker Desktop host.
#   app/   = /app of johnson163/pandia_emulator (layer 2e6768f8, 2024-02-03):
#            simulation_Release (WebRTC, OpenH264 when NVENC is unset) + media
#   rbwe/  = RBWE's sb3_client.py (trace replay via tc.sh) and pandia package
#   nvstub = no-device stubs for libcuda / libnvidia-encode / libnvcuvid
FROM pandia-emubase:local
COPY app/ /app/
COPY rbwe/sb3_client.py /app/sb3_client.py
COPY rbwe/pandia /app/pandia
# trace replay that replaces RBWE's tc.sh (see emulator/trace_replay.py)
COPY emulator/trace_replay.py emulator/sb3_client_local.py emulator/rx_capture.py emulator/audio_flow.py /app/
COPY nvstub/libcuda.so.1 nvstub/libnvidia-encode.so.1 nvstub/libnvcuvid.so.1 /usr/local/lib/nvstub/
ENV LD_LIBRARY_PATH=/usr/local/lib/nvstub
# RBWE starts /app/simulation_video_save (not public). Ours is simulation_shm7:
# johnson-li/webrtc@pandia (bfc4443) + webrtc/metaband-shm7.patch, where shm
# field 7 (prediction_bandwidth, bps) replaces GoogCC's target rate; 0 = GoogCC.
# simulation_Release (public build, ignores field 7) stays for reference.
RUN chmod +x /app/simulation_Release /app/simulation_shm7  && ln -sf /app/simulation_shm7 /app/simulation_video_save
WORKDIR /app
CMD ["python", "-um", "sb3_client_local"]
