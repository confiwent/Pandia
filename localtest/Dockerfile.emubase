# Base for the local Pandia emulator container: driver deps + tc + jq.
FROM pandia-driver:local
RUN sed -i "s|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g" /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::Retries=8 update \
 && apt-get -o Acquire::Retries=8 install -y --no-install-recommends iproute2 jq procps \
 && rm -rf /var/lib/apt/lists/*
