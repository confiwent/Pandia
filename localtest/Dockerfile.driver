# Driver container for running Pandia's Python side on a Windows host
# (AF_UNIX datagram sockets do not work in native Windows Python).
FROM python:3.8-slim
COPY --from=docker:27.3.1-cli /usr/local/bin/docker /usr/local/bin/docker
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple PIP_DEFAULT_TIMEOUT=300
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu torch==2.0.1+cpu \
 && pip install --no-cache-dir numpy==1.23.5 gymnasium==0.28.1 docker==6.1.3 matplotlib==3.7.1 \
      scipy==1.10.1 onnxruntime==1.16.3 stable-baselines3==2.1.0 pandas==2.0.2
WORKDIR /data2/kj/Workspace/Pandia
# docker-py 6.1.3 breaks with requests>=2.32 ("Not supported URL scheme http+docker")
RUN pip install --no-cache-dir requests==2.31.0
