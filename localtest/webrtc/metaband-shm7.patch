 #
 # Use of this source code is governed by a BSD-style license
@@ -479,10 +483,9 @@ rtc_library("nvenc_h264") {
 
   defines = []
    
-  lib_dirs = [
-    "/usr/local/cuda-12.1/targets/x86_64-linux/lib/stubs",
-    "/home/lix16/Workspace/webrtc/src/libs",
-  ]
+  # Directory with libcuda.so / libnvcuvid.so / libnvidia-encode.so (driver
+  # libraries or stubs); set with gn arg nv_lib_dir.
+  lib_dirs = [ nv_lib_dir ]
  
   libs = [
     "cuda",
